{
  "item": [
    {
      "id": "f12e5305-fe26-4e22-bc1c-981850da2ae6",
      "name": "Synthetic Calls",
      "description": {
        "content": "The API endpoints of this group can fetch, update and delete the synthetic endpoint configuration rules.\n\n**Note:** There are some following restrictions to use `matchSpecification` parameter for Synthetic endpoint configuration: \n\n1. `matchSpecification.type` should be `LEAF`.\n2. `matchSpecification.key` should be always be `endpoint.name`.\n3. `matchSpecification.operator` should be among the following options: `EQUALS`, `CONTAINS`, `STARTS_WITH`, `ENDS_WITH`, `NOT_STARTS_WITH`, `NOT_ENDS_WITH`.\n4. `matchSpecification.entity` should be `DESTINATION` as health check endpoint is considered as a destination endpoint.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8db256c6-f66f-42c7-b014-2c3f216dacbf",
          "name": "Delete synthetic call configurations",
          "request": {
            "name": "Delete synthetic call configurations",
            "description": {
              "content": "Use this API endpoint if one wants to delete all custom synthetic call configurations.\nThis endpoint requires `CanConfigureServiceMapping` permission.\nOne can use `Create or update an API token` endpoint to update the permission by setting `canConfigureServiceMapping` to `true`.\nIf one wants to enable the permission from Instana UI, go to Settings -> Security & Access -> Access Control -> API Token.\nThere one can update the existing token or create a new token and set `Customize service rules and endpoint mapping` to `true`.\n\nFor more information on Synthetic Calls please access the https://developer.ibm.com/apis/catalog/instana--instana-rest-api/Settings#synthetic-calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "settings",
                "synthetic-calls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
