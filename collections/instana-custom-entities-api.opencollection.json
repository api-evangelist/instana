            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{unit}-{tenant}.instana.io/api/custom-entitytypes",
            "auth": {
              "type": "apikey",
              "key": "authorization",
              "value": "{{authorization}}",
              "placement": "header"
            }
          },
          "docs": "This end point lists custom Entity Type Definition"
        },
        {
