      "items": [
        {
          "info": {
            "name": "Get accessible custom dashboards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{unit}-{tenant}.instana.io/api/custom-dashboard",
            "params": [
              {
                "name": "query",
                "value": "BeeInstana",
                "type": "query",
                "description": "query"
              },
              {
                "name": "pageSize",
                "value": "2",
                "type": "query",
                "description": "pageSize"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "page"
              },
              {
                "name": "withTotalHits",
                "value": "false",
                "type": "query",
                "description": "withTotalHits"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "authorization",
              "value": "{{authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get all accessible custom dashboards details.\nFor more information on custom dashboards please access the https://developer.ibm.com/apis/catalog/instana--instana-rest-api/Settings#custom-dashboards."
        },
        {
          "info": {
            "name": "Add custom dashboard",
