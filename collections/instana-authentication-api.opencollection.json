{
  "opencollection": "1.0.0",
  "info": {
    "name": "Instana REST API documentation Authentication API",
    "version": "1.307.1417"
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delete Google SSO configuration",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{unit}-{tenant}.instana.io/api/settings/authentication/googleSSO",
            "auth": {
              "type": "apikey",
              "key": "authorization",
              "value": "{{authorization}}",
              "placement": "header"
            }
          },
          "docs": "Delete the corresponding tenants Google SSO configuration."
        },
        {
